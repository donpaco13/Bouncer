<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
    Plurais do app em português do Brasil : duas formas CLDR, `one` e `other`.
    Sempre `%d` em cada forma, nunca um número fixo.
-->
<plist version="1.0">
<dict>
    <key>welcome.ready.appsFound</key>
    <dict>
        <key>NSStringLocalizedFormatKey</key>
        <string>%#@apps@</string>
        <key>apps</key>
        <dict>
            <key>NSStringFormatSpecTypeKey</key>
            <string>NSStringPluralRuleType</string>
            <key>NSStringFormatValueTypeKey</key>
            <string>d</string>
            <key>one</key>
            <string>%d app de notch encontrado</string>
            <key>other</key>
            <string>%d apps de notch encontrados</string>
        </dict>
    </dict>
    <key>settings.general.refresh.interval</key>
    <dict>
        <key>NSStringLocalizedFormatKey</key>
        <string>%#@seconds@</string>
        <key>seconds</key>
        <dict>
            <key>NSStringFormatSpecTypeKey</key>
            <string>NSStringPluralRuleType</string>
            <key>NSStringFormatValueTypeKey</key>
            <string>d</string>
            <key>one</key>
            <string>%d segundo</string>
            <key>other</key>
            <string>%d segundos</string>
        </dict>
    </dict>
</dict>
</plist>
